{
  "openapi": "3.0.3",
  "info": {
    "title": "ICR Platform API",
    "version": "1.0.0",
    "description": "Backend API for ICR platform"
  },
  "servers": [
    {
      "url": "http://localhost:3001"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": { "type": "string" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "login": { "type": "string", "example": "admin" },
          "full_name": { "type": "string", "example": "System Admin" },
          "role": { "type": "string", "enum": ["ADMIN", "SUPERVISOR", "OPERATOR"] },
          "active": { "type": "boolean", "example": true }
        }
      },
      "Form": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "name": { "type": "string", "example": "Passport" },
          "template_json": { "type": "object", "additionalProperties": true }
        }
      },
      "Field": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 10 },
          "form_id": { "type": "integer", "example": 1 },
          "name": { "type": "string", "example": "First name" },
          "code": { "type": "string", "example": "first_name" },
          "data_type": { "type": "string", "example": "text" },
          "required": { "type": "boolean", "example": true },
          "allowed_chars": { "type": "string", "example": "A-Za-z " },
          "validation_rule": { "type": ["object", "null"], "additionalProperties": true }
        }
      },
      "Cell": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 3 },
          "form_id": { "type": "integer", "example": 1 },
          "field_id": { "type": "integer", "example": 10 },
          "x": { "type": "number", "example": 10 },
          "y": { "type": "number", "example": 20 },
          "width": { "type": "number", "example": 120 },
          "height": { "type": "number", "example": 30 },
          "position_x": { "type": "number", "example": 0 },
          "position_y": { "type": "number", "example": 0 },
          "expected_value": { "type": "string", "nullable": true }
        }
      },
      "Document": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 101 },
          "filename": { "type": "string", "example": "1700000000000-passport.png" },
          "original_name": { "type": "string", "example": "passport.png" },
          "form_id": { "type": "integer", "example": 1 },
          "status": { "type": "string", "enum": ["NEW", "PROCESSING", "RECOGNIZED", "CHECKING", "COMPLETED", "EXPORTED", "ERROR"] },
          "created_by": { "type": "integer", "example": 1 }
        }
      },
      "Batch": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 12 },
          "name": { "type": "string", "example": "Batch #1" },
          "status": { "type": "string", "enum": ["NEW", "ASSIGNED", "IN_PROGRESS", "COMPLETED", "CLOSED"] },
          "created_by": { "type": "integer", "example": 1 }
        }
      },
      "BatchProgress": {
        "type": "object",
        "properties": {
          "totalDocuments": { "type": "integer", "example": 10 },
          "statusCounts": { "type": "object", "additionalProperties": { "type": "integer" } },
          "completed": { "type": "integer", "example": 7 },
          "progressPercent": { "type": "integer", "example": 70 }
        }
      },
      "RecognitionJob": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 42 },
          "document_id": { "type": "integer", "example": 101 },
          "status": { "type": "string", "enum": ["NEW", "IN_PROGRESS", "COMPLETED", "ERROR"] },
          "worker_id": { "type": "string", "nullable": true }
        }
      },
      "RecognitionCell": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 3 },
          "recognition_job_id": { "type": "integer", "example": 42 },
          "form_cell_id": { "type": "integer", "example": 5 },
          "recognized_value": { "type": "string", "nullable": true },
          "confidence": { "type": "number", "nullable": true }
        }
      },
      "CharacterSample": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 8 },
          "form_id": { "type": "integer", "example": 1 },
          "field_id": { "type": "integer", "example": 10 },
          "symbol": { "type": "string", "example": "A" },
          "confidence": { "type": "integer", "example": 99 },
          "image_path": { "type": "string", "nullable": true }
        }
      },
      "OperatorAction": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 15 },
          "action": { "type": "string", "example": "VERIFY" },
          "comment": { "type": "string", "example": "Checked manually" },
          "user_id": { "type": "integer", "example": 2 },
          "created_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "security": [{
    "bearerAuth": []
  }],
  "paths": {
    "/health": {
      "get": {
        "tags": ["system"],
        "summary": "Health check",
        "security": [],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["auth"],
        "summary": "Authenticate user",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["login", "password"],
                "properties": {
                  "login": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JWT token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["auth"],
        "summary": "Current user profile",
        "responses": {
          "200": {
            "description": "User",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api/users": {
      "get": {
        "tags": ["users"],
        "summary": "List users",
        "responses": {
          "200": {
            "description": "Users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["users"],
        "summary": "Create user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["login", "password"],
                "properties": {
                  "login": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "fullName": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string",
                    "enum": ["ADMIN", "SUPERVISOR", "OPERATOR"],
                    "default": "OPERATOR"
                  },
                  "active": {
                    "type": "boolean",
                    "default": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api/forms": {
      "get": {
        "tags": ["forms"],
        "summary": "List forms",
        "responses": {
          "200": {
            "description": "Forms",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Form"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["forms"],
        "summary": "Create form",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "template": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "fields": {
                    "type": "array"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created form",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Form" }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api/forms/{formId}/fields": {
      "get": {
        "tags": ["fields"],
        "summary": "List form fields",
        "parameters": [
          {
            "in": "path",
            "name": "formId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Fields",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Field"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["fields"],
        "summary": "Add field to form",
        "parameters": [
          {
            "in": "path",
            "name": "formId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "code"],
                "properties": {
                  "name": { "type": "string" },
                  "code": { "type": "string" },
                  "dataType": { "type": "string", "default": "text" },
                  "required": { "type": "boolean", "default": false },
                  "allowedChars": { "type": "string" },
                  "validationRule": { "type": "object", "nullable": true }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created field",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Field" }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api/forms/{formId}/cells": {
      "get": {
        "tags": ["cells"],
        "summary": "List form cells",
        "parameters": [
          {
            "in": "path",
            "name": "formId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cells",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Cell"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["cells"],
        "summary": "Add cell to form",
        "parameters": [
          {
            "in": "path",
            "name": "formId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["fieldId"],
                "properties": {
                  "fieldId": { "type": "integer" },
                  "x": { "type": "number" },
                  "y": { "type": "number" },
                  "width": { "type": "number" },
                  "height": { "type": "number" },
                  "positionX": { "type": "number" },
                  "positionY": { "type": "number" },
                  "expectedValue": { "type": "string", "nullable": true }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Cell" }
              }
            }
          }
        }
      }
    },
    "/api/documents": {
      "get": {
        "tags": ["documents"],
        "summary": "List documents",
        "responses": {
          "200": {
            "description": "Documents",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Document" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["documents"],
        "summary": "Upload a new document",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file", "formId"],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "formId": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Document" }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api/documents/{id}": {
      "get": {
        "tags": ["documents"],
        "summary": "Get document",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Document",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Document" }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api/documents/{id}/status": {
      "patch": {
        "tags": ["documents"],
        "summary": "Set document status",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": ["NEW", "PROCESSING", "RECOGNIZED", "CHECKING", "COMPLETED", "EXPORTED", "ERROR"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "integer" },
                    "status": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "409": {
            "description": "Invalid transition",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api/documents/{id}/allowed-statuses": {
      "get": {
        "tags": ["documents"],
        "summary": "Allowed document status transitions",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Transitions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "current": { "type": "string" },
                    "allowedTransitions": {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/batches": {
      "get": {
        "tags": ["batches"],
        "summary": "List batches",
        "responses": {
          "200": {
            "description": "Batches",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Batch" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["batches"],
        "summary": "Create batch",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "status": { "type": "string", "enum": ["NEW", "ASSIGNED", "IN_PROGRESS", "COMPLETED", "CLOSED"] }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Batch" }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api/batches/{id}": {
      "get": {
        "tags": ["batches"],
        "summary": "Get batch with documents and progress",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Batch",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "allOf": [
                    { "$ref": "#/components/schemas/Batch" },
                    { "type": "object", "properties": { "documents": { "type": "array", "items": { "$ref": "#/components/schemas/Document" } }, "totalDocuments": { "type": "integer" }, "statusCounts": { "type": "object", "additionalProperties": { "type": "integer" } }, "completed": { "type": "integer" }, "progressPercent": { "type": "integer" } } }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      },
      "patch": {
        "tags": ["batches"],
        "summary": "Set batch status",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "status": { "type": "string", "enum": ["NEW", "ASSIGNED", "IN_PROGRESS", "COMPLETED", "CLOSED"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Batch" }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "409": {
            "description": "Invalid transition",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api/batches/{id}/documents": {
      "post": {
        "tags": ["batches"],
        "summary": "Attach documents to batch",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["documentIds"],
                "properties": {
                  "documentIds": {
                    "type": "array",
                    "items": { "type": "integer" }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Documents attached",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "batchId": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/batches/{id}/allowed-statuses": {
      "get": {
        "tags": ["batches"],
        "summary": "Allowed batch status transitions",
        "parameters": [
          {
            "in": "path",
            "name": "id",
